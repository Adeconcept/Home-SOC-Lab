index=endpoint
sourcetype=det:sysmon"
Id="1"
Message="*powershell*"
(Message="*-EncodedCommand*" OR Message="*-enc *")
| rex field=Message "Image:\s+(?<Image>[^\r\n]+)"
| rex field=Message "CommandLine:\s+(?<CommandLine>[^\r\n]+)"
| rex field=Message "ParentImage:\s+(?<ParentImage>[^\r\n]+)"
| rex field=Message "User:\s+(?<User>[^\r\n]+)"
| eval severity=case(
    match(lower(ParentImage), "winword.exe|excel.exe|outlook.exe"), "high",
    true(), "medium"
)
| table _time host User Image ParentImage CommandLine severity
